# Copy to .env.local for local development. Never commit .env or .env.local.
# Vite inlines these at BUILD time: set them in your host's dashboard, then redeploy.

# REQUIRED. Origin of the backend API, no trailing slash.
# Local FastAPI (this repo's server/): include the /api prefix so paths like
# /health, /stats/summary, /ranking/cves resolve under uvicorn on port 8000.
#   Same-origin production / Vite proxy : /api
#   Separate backend                 : http://localhost:8000/api
#   Production    : https://api.example.com/api
#   No backend    : demo   (sample data + in-browser scoring; live ranking disabled)
# If this is missing the app shows a configuration error screen instead of loading.
# The backend must send CORS headers allowing this app's origin (see README).
VITE_API_URL=http://localhost:8000/api

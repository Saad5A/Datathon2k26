# Copy to .env (gitignored) and fill in. Never commit .env or paste these values anywhere.
# Toronto region URL: https://ca-tor.ml.cloud.ibm.com
WATSONX_APIKEY=
WATSONX_URL=
WATSONX_PROJECT_ID=

# Optional: live Gemini executive playbooks (not needed for ranking/upload)
GEMINI_API_KEY=

# Optional: select a specific IBM Granite instruct model
GRANITE_INSTRUCT_MODEL=ibm/granite-3-8b-instruct

# Optional: location of the IBM datathon data folder (known_exploited.csv etc.)
IBM_DATA_DIR=
